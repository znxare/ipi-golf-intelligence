# Copy this file to .env.local (git-ignored) and fill in your Neon project's
# values — `neon env pull` prints them as NEON_AUTH_BASE_URL / NEON_DATA_API_URL.
#
# Leave both blank / omit this file entirely to run against localStorage only
# (no database, no login).

VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
