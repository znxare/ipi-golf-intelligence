# Copy this file to .env.local (git-ignored) and fill in your Supabase project's
# values — Settings → API in the Supabase dashboard.
#
# Leave both blank / omit this file entirely to run against localStorage only
# (no database, no login) — this is the default until you configure Supabase.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
